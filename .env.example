# ===========================================================================
# Zoom Clone - Environment Variables Template
# ===========================================================================

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
# Base URL of the Django REST API. Used by the API client.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ---------------------------------------------------------------------------
# Backend (Django / Daphne)
# ---------------------------------------------------------------------------
# Django Secret Key (never commit the real production key!)
SECRET_KEY=django-insecure-placeholder-key-for-local-development

# Toggle debug mode (True for development, False for production)
DEBUG=True

# List of host/domain names that this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1

# Allowed origins for CORS requests
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base URL of the Next.js frontend (used to construct invite links)
FRONTEND_URL=http://localhost:3000
